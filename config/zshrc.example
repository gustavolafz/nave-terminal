# ==============================================================================
# ~/.zshrc example for Nave Terminal v4 (100% Standalone — Zero Oh My Zsh)
# ==============================================================================

export PATH="$HOME/.local/bin:$PATH"

# Directory used by the `p` project hub command
export NAVE_PROJECTS_DIR="$HOME/projects"

# Optional: fast lazy-load NVM (<1ms startup, Node available immediately in PATH)
# export NVM_DIR="$HOME/.nvm"
