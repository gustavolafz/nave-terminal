#   nvm() { unfunction nvm; [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"; nvm "$@"; }
# fi

# Handy aliases
alias ..='cd ..'
alias ...='cd ../..'
alias d='dirs -v | head -n 15'
alias glog='git log --graph --oneline --decorate -n 20'
alias reload="source ~/.zshrc && echo 'zshrc recarregado!'"

# Load Nave Terminal v4 (theme, nave-z, toolkit, nave-suggest, VS Code keybindings, nave-highlight)
[[ -r "$HOME/.config/nave/init.zsh" ]] && source "$HOME/.config/nave/init.zsh"
